# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI / LLM ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=            # Optional — Google Gemini
# GOOGLE_GENAI_API_KEY=      # Optional — Google GenAI

# ─── Meta / WhatsApp / Instagram ─────────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
# NEXT_PUBLIC_META_WA_CONFIG_ID=   # WhatsApp Embedded Signup config ID

# ─── Google Calendar (OAuth) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── LiveKit (Voice Agent) ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# ─── Stripe (Billing) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENTIAL_MONTHLY=price_...
STRIPE_PRICE_ESSENTIAL_ANNUAL=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...

# ─── n8n (Workflow Engine) ──────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com
N8N_RESULT_SECRET=your-n8n-result-secret
WORKFLOW_INTERNAL_SECRET=your-workflow-secret
# N8N_API_KEY=               # Optional — for n8n-update.js

# ─── Cron / Security ────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ─── Monitoring ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# LANGSMITH_API_KEY=

# ─── Demo Mode (Optional) ───────────────────────────────────────────────────
# DEMO_ORG_ID=
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=

# ─── Eval (Optional) ────────────────────────────────────────────────────────
# EVAL_API_SECRET=
